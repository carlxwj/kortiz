rules_version = '2';

// ============================================================================
// Kortiz — règles Cloud Storage
// Photos de tickets : groups/{groupId}/receipts/{expenseId}.jpg
// Lecture / écriture réservées aux membres du groupe, images de 2 Mo maximum.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isMember(gid) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(gid)).data.memberIds;
    }

    match /groups/{gid}/receipts/{file} {
      allow read: if isMember(gid);
      // L'auteur peut fournir une seule photo ; aucune réécriture ou suppression
      // directe après dépôt. La fonction onExpenseWritten gère la suppression.
      allow create: if isMember(gid)
        && file.matches('[A-Za-z0-9_-]{1,150}\\.jpg')
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && ('ownerUid' in request.resource.metadata)
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    function inDirectChat(cid) {
      let data = firestore.get(/databases/(default)/documents/directChats/$(cid)).data;
      let other = data.members.size() == 2 ? (data.members[0] == request.auth.uid ? data.members[1] : data.members[0]) : request.auth.uid;
      return request.auth != null && request.auth.uid in data.members
        && (data.members.size() == 1 || (data.members.size() == 2
          && !firestore.exists(/databases/(default)/documents/blocks/$(request.auth.uid)/users/$(other))
          && !firestore.exists(/databases/(default)/documents/blocks/$(other)/users/$(request.auth.uid))));
    }
    function activeDirectChat(cid) {
      return firestore.get(/databases/(default)/documents/directChats/$(cid)).data.members.size() == 2;
    }
    function allowedMedia() {
      return request.resource.size > 0
        && ((request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 8 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 25 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/(webm|mp4|mpeg|ogg)') && request.resource.size <= 10 * 1024 * 1024));
    }
    match /supportReports/{uid}/{filename} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && filename.matches('[A-Za-z0-9]{20,30}\\.jpg')
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /avatars/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /chat/group/{gid}/{uid}/{filename} {
      allow read: if isMember(gid);
      allow create: if request.auth != null && request.auth.uid == uid && isMember(gid)
        && filename.matches('[A-Za-z0-9_-]{12,80}\\.(jpg|png|webp|mp4|webm|mov|mp3|m4a|ogg)') && allowedMedia();
      allow delete: if request.auth != null && request.auth.uid == uid && isMember(gid);
      allow update: if false;
    }
    match /chat/direct/{cid}/{uid}/{filename} {
      allow read: if inDirectChat(cid);
      allow create: if request.auth != null && request.auth.uid == uid && inDirectChat(cid) && activeDirectChat(cid)
        && filename.matches('[A-Za-z0-9_-]{12,80}\\.(jpg|png|webp|mp4|webm|mov|mp3|m4a|ogg)') && allowedMedia();
      allow delete: if request.auth != null && request.auth.uid == uid && inDirectChat(cid);
      allow update: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
